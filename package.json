{
  "name": "paper-reader",
  "version": "0.1.16",
  "description": "支持中英对照、联动阅读、批注与 API 询问的论文阅读器",
  "type": "module",
  "main": "out/main/index.js",
  "license": "AGPL-3.0-only",
  "author": "Paper Reader contributors",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "test": "vitest run",
    "test:ui": "node scripts/pair-smoke.mjs && node scripts/settings-smoke.mjs && node scripts/question-smoke.mjs && node scripts/shortcuts-smoke.mjs && node scripts/documents-smoke.mjs && node scripts/pair-drop-smoke.mjs && node scripts/outline-smoke.mjs",
    "test:outline": "node scripts/outline-smoke.mjs",
    "test:documents": "node scripts/documents-smoke.mjs",
    "test:pair-drop": "node scripts/pair-drop-smoke.mjs",
    "test:pair": "node scripts/pair-smoke.mjs",
    "test:zoom": "node scripts/zoom-smoke.mjs --settle-profile --check-clear-scroll",
    "test:settings": "node scripts/settings-smoke.mjs",
    "test:shortcuts": "node scripts/shortcuts-smoke.mjs",
    "test:scroll": "node scripts/scroll-smoke.mjs",
    "test:reader-cold": "node scripts/scroll-smoke.mjs --profile --cold-only --rounds=3 --foreground --cache-mib=64 --dpr=1.5",
    "test:inspection": "node scripts/inspection-performance-smoke.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "test:replay": "node scripts/test-replay.mjs",
    "experiment:tokens": "node scripts/token-cache-experiment.mjs",
    "test:references": "node scripts/layout-smoke.mjs",
    "test:installer": "node scripts/installer-smoke.mjs",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "package": "npm run build && node scripts/make-icon.mjs && node scripts/package-source.mjs && node scripts/build-installer.mjs"
  },
  "build": {
    "appId": "org.paperreader.desktop",
    "productName": "论文对照阅读器",
    "artifactName": "PaperReader-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/source-code.zip",
        "to": "source-code.zip"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "executableName": "PaperReader",
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "useZip": true
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "lucide-react": "^1.58.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
